# Cloudflare DDNS - Environment Variable Configuration
# Copy this file to .env and set your values.
# Setting CLOUDFLARE_API_TOKEN (or DOMAINS / IP4_DOMAINS / IP6_DOMAINS)
# activates environment variable mode.
# Booleans: only true / 1 / yes (case-insensitive) are true; anything else is false.

# === Required ===

# Cloudflare API token. Required permissions on the target zones:
#   Zone > DNS > Edit and Zone > Zone > Read
# (plus Account > Account Filter Lists > Edit if you use WAF_LISTS).
# Do not wrap the value in quotes. The placeholder below is rejected at startup.
CLOUDFLARE_API_TOKEN=YOUR-CLOUDFLARE-API-TOKEN
# Or read from a file:
# CLOUDFLARE_API_TOKEN_FILE=/run/secrets/cloudflare_token

# Domains to update (comma-separated)
# At least one of DOMAINS, IP4_DOMAINS, IP6_DOMAINS, or WAF_LISTS must be set
DOMAINS=example.com,www.example.com
# IP4_DOMAINS=v4only.example.com
# IP6_DOMAINS=v6only.example.com

# === IP Detection ===

# Provider for IPv4 detection (default: cloudflare.trace)
# Options: cloudflare.trace, cloudflare.trace:<url>, cloudflare.doh, ipify, local,
#          local.iface:<name>, local.iface.stable:<name>, url:<custom-url>,
#          literal:<ip1>,<ip2> (comma or space separated), none (or empty)
# IP4_PROVIDER=cloudflare.trace

# Provider for IPv6 detection (default: cloudflare.trace)
# Use local.iface.stable:<name> on Linux to publish a stable address instead
# of temporary privacy addresses from the selected interface.
# IP6_PROVIDER=cloudflare.trace

# Reject detected IPs inside Cloudflare's published ranges (default: true)
# REJECT_CLOUDFLARE_IPS=true

# === Scheduling ===

# Update schedule (default: @every 5m)
# Formats: @every 5m, @every 1h, @every 30s (minimum 30s), @once
# UPDATE_CRON=@every 5m

# Run an update immediately on startup (default: true)
# UPDATE_ON_START=true

# Delete managed DNS records on shutdown (default: false)
# DELETE_ON_STOP=false

# Delete managed DNS records when a deterministic provider (literal:, local,
# local.iface:, local.iface.stable:) reports no address of that family
# (default: false).
# Transient detection errors (network failures) always preserve existing
# records, regardless of this setting.
# DELETE_ON_FAILURE=false

# === DNS Records ===

# TTL in seconds: 1=auto, or 30-86400; values below 30 mean auto (default: 1)
# TTL=1

# Proxied expression: true, false, is(domain), sub(domain), or boolean combos
# PROXIED=false

# Comment to attach to managed DNS records
# RECORD_COMMENT=Managed by cloudflare-ddns

# Regex to identify which records are managed (empty = all matching records)
# MANAGED_RECORDS_COMMENT_REGEX=cloudflare-ddns

# === WAF Lists ===

# Comma-separated WAF lists in account-id/list-name format
# WAF_LISTS=account123/my_ip_list

# Description used when a missing WAF list is created
# WAF_LIST_DESCRIPTION=Dynamic IP list

# Comment for WAF list items
# WAF_LIST_ITEM_COMMENT=cloudflare-ddns

# Regex to identify managed WAF list items
# MANAGED_WAF_LIST_ITEMS_COMMENT_REGEX=cloudflare-ddns

# === Notifications ===

# Shoutrrr notification URL. SHOUTRRR accepts several newline-separated URLs,
# but a .env file can only hold ONE line per variable — set exactly one
# SHOUTRRR line here. For several services, use a YAML block scalar in
# docker-compose.yml (see README) instead.
# Examples (pick one):
#   discord://token@webhook-id
#   slack://token-a/token-b/token-c
#   telegram://bot-token@telegram?chats=chat-id
#   pushover://shoutrrr:api-token@user-key
#   gotify://gotify.example.com/app-token
#   generic+https://hooks.example.com/webhook
# SHOUTRRR=discord://token@webhook-id

# === Heartbeat Monitoring ===

# Healthchecks.io ping URL
# HEALTHCHECKS=https://hc-ping.com/your-uuid

# Uptime Kuma push URL. Paste it as shown in Uptime Kuma; a trailing
# query string such as ?status=up&msg=OK&ping= is stripped automatically.
# UPTIMEKUMA=https://your-uptime-kuma.com/api/push/your-token

# === Timeouts ===

# IP detection timeout (default: 5s). Formats: 30s, 5m, 1h, or bare seconds
# DETECTION_TIMEOUT=5s

# Cloudflare API request timeout (default: 30s)
# UPDATE_TIMEOUT=30s

# === Output ===

# Use emoji in output (default: true)
# EMOJI=true

# Suppress informational output (default: false)
# QUIET=false
